#!/usr/bin/env python
import os

I18N_PACKAGE = 'ardour-android'

def options(opt):
    pass

def configure(conf):
    pass

def build(bld):
    # The JNI bridge: the platform independent protocol over libardour
    # (engine_protocol.cc, shared with the iOS and wasm hosts later) and its
    # JNI adapter.  It also links the AAudio wrapper directly, to list the
    # devices before the engine is started.
    obj = bld(features = 'cxx cxxshlib')
    obj.source = [
            'engine_protocol.cc',
            'ardour_android.cc',
            ]
    obj.includes = ['.']
    obj.name     = 'ardour_android'
    obj.target   = 'ardour_android'
    obj.use      = ['libardour', 'libpbd', 'libtemporal', 'libevoral', 'aaudio_device']
    obj.uselib   = ['GLIBMM', 'GIOMM', 'SIGCPP', 'XML', 'LO', 'TAGLIB', 'SNDFILE']
    obj.linkflags = ['-llog']
    obj.install_path  = os.path.join(bld.env['LIBDIR'])
    obj.defines = [
            'ARDOUR_ANDROID_VERSION="' + bld.env.get('VERSION', 'unknown') + '"',
            'ARDOUR_TARGET_OS="' + bld.env.get('TARGET_OS', 'unknown') + '"',
            'ARDOUR_TARGET_ABI="' + bld.env.get('TARGET_ABI', 'unknown') + '"',
            'ARDOUR_ANDROID_API=' + str (bld.env.get('ANDROID_API', 0)),
            ]
