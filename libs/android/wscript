#!/usr/bin/env python
import os

I18N_PACKAGE = 'ardour-android'

def options(opt):
    pass

def configure(conf):
    pass

def build(bld):
    # The JNI bridge: the platform independent protocol over libardour
    # (engine_protocol.cc, shared with the iOS and wasm hosts later) and its
    # JNI adapter.  It also links the AAudio wrapper directly, to list the
    # devices before the engine is started.
    obj = bld(features = 'cxx cxxshlib')
    obj.source = [
            'engine_protocol.cc',
            'ardour_android.cc',
            ]
    obj.includes = ['.', '../backends/aaudio']
    obj.name     = 'ardour_android'
    obj.target   = 'ardour_android'
    obj.use      = ['libardour', 'libpbd', 'libtemporal', 'libevoral', 'aaudio_device']
    obj.uselib   = ['GLIBMM', 'GIOMM', 'SIGCPP', 'XML', 'LO', 'TAGLIB', 'SNDFILE', 'SAMPLERATE']
    obj.linkflags = ['-llog', '-laaudio']
    obj.install_path  = os.path.join(bld.env['LIBDIR'])
    obj.defines = [
            'ARDOUR_ANDROID_VERSION="' + str (bld.env['VERSION'] or 'unknown') + '"',
            'ARDOUR_TARGET_OS="' + str (bld.env['TARGET_OS'] or 'unknown') + '"',
            'ARDOUR_TARGET_ABI="' + str (bld.env['TARGET_ABI'] or 'unknown') + '"',
            'ARDOUR_ANDROID_API=' + str (bld.env['ANDROID_API'] or 0),
            ]
