#!/usr/bin/env python
import os

I18N_PACKAGE = 'aaudio-backend'

def options(opt):
    pass

def configure(conf):
    # AAudio is part of the NDK (libaaudio.so) and only exists from API 26 on
    if conf.env['TARGET_OS'] != 'android':
        conf.fatal("the aaudio backend is only available for an Android target")
    if int (conf.env['ANDROID_API'] or 26) < 26:
        conf.fatal("the aaudio backend needs Android API 26 or later (AAudio was added in API 26)")
    conf.check_cc(header_name='aaudio/AAudio.h', mandatory=True)
    conf.check_cc(linkflags='-laaudio', mandatory=True, execute=False,
                  msg='Checking for libaaudio')

def build(bld):
    # The AAudio wrapper is plain C without an Ardour dependency, so that it
    # can be built on its own against the NDK: that is what the CI job does,
    # and it is the only part of the Android build that does not need the
    # cross-compiled dependency stack of Ardour itself.
    device = bld(features = 'c cstaticlib')
    device.source = ['aaudio_device.c']
    device.includes = ['.']
    device.target = 'aaudio_device'

    obj = bld(features = 'cxx cxxshlib')
    obj.source = ['aaudio_audiobackend.cc']
    obj.includes = ['.']
    obj.name     = 'aaudio_audiobackend'
    obj.target   = 'aaudio_audiobackend'
    obj.use      = ['aaudio_device', 'libardour', 'libpbd']
    obj.uselib   = 'GLIBMM XML'
    obj.install_path  = os.path.join(bld.env['LIBDIR'], 'backends')
    obj.defines = ['PACKAGE="' + I18N_PACKAGE + '"',
                   'ARDOURBACKEND_DLL_EXPORTS'
                  ]
